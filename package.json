{
  "name": "planner",
  "productName": "Planner",
  "version": "0.1.1",
  "description": "Planner v2 — application de planification personnelle",
  "main": "./out/main/index.js",
  "author": "Planner",
  "private": true,
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "vitest run",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "dev:phone": "vite --config vite.phone.config.mts",
    "build:phone": "vite build --config vite.phone.config.mts && node scripts/phone-postbuild.mjs",
    "preview:phone": "vite preview --config vite.phone.config.mts",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "install-electron && electron-builder install-app-deps",
    "dist": "npm run build && electron-builder --win nsis",
    "release": "node scripts/release.mjs",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run dist"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "@fontsource/inter": "^5.3.0",
    "@tiptap/core": "^3.33.1",
    "@tiptap/extension-task-item": "^3.33.1",
    "@tiptap/extension-task-list": "^3.33.1",
    "@tiptap/pm": "^3.33.1",
    "@tiptap/react": "^3.33.1",
    "@tiptap/starter-kit": "^3.33.1",
    "dexie": "^4.4.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rrule": "^2.8.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.1",
    "@electron-toolkit/eslint-config-ts": "^4.0.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@types/node": "^24.19.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fake-indexeddb": "^6.2.8",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.1.0"
  }
}
